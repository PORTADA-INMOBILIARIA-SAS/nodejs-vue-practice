# ==============================================================================
# VARIABLES DE ENTORNO REQUERIDAS PARA EL DESPLIEGUE (DEPLOYMENT)
# ==============================================================================
# Copia este archivo a `.env` para desarrollo local:
#   cp .env.example .env
#
# Para el despliegue en producción (ej. Vercel / Netlify / Servidor):
# Configurar estas variables en la sección "Environment Variables" del proyecto.
# ==============================================================================

# [OBLIGATORIA]
# API Key / Token de SIMI Inmobiliaria.
# Requerida en servidor para consultar endpoints de la API:
# - /api/property (detalle de inmueble)
# - /api/locations (ubicaciones y ciudades)
# - /api/types (tipos de inmuebles)
# - /api/zones (zonas y barrios)
SECRET_SIMI_API_KEY=tu_api_key_de_simi_aqui
