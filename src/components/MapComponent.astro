---
interface Props {
  properties: Array<any>
}

const { properties = [] } = Astro.props
const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY
---

<!-- Mapa -->
<div class="general-map-wrapper w-full h-[580px] rounded-3xl overflow-hidden border border-[#e0dcd3] shadow-md relative">
  <div
    id="general-locations-map"
    class="w-full h-full"
    data-api-key={apiKey}
  ></div>
</div>

<!-- Tarjeta de inmueble seleccionado (oculta por defecto) -->
<div
  id="gm-property-card"
  class="hidden mt-3 rounded-2xl border border-[#e0dcd3] bg-white shadow-lg overflow-hidden"
  style="max-width:100%"
>
  <div class="flex gap-0">
    <!-- Foto -->
    <div class="relative shrink-0 w-[130px] sm:w-[160px] h-[130px] sm:h-[150px] overflow-hidden bg-[#f0ece6]">
      <img
        id="gm-card-photo"
        src=""
        alt=""
        class="w-full h-full object-cover"
        onerror="this.style.display='none'"
      />
      <div
        id="gm-card-no-photo"
        class="hidden absolute inset-0 flex items-center justify-center"
      >
        <svg
          class="w-10 h-10 text-[#c9c4b8]"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M13.5 10.5h.008v.008H13.5V10.5zm-7.5 9h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15A2.25 2.25 0 002.25 6.75v10.5A2.25 2.25 0 004.5 19.5z"
          />
        </svg>
      </div>
    </div>

    <!-- Info -->
    <div class="flex-1 p-4 flex flex-col justify-between min-w-0">
      <div>
        <!-- Tags tipo + modo -->
        <div class="flex gap-2 mb-2 flex-wrap">
          <span
            id="gm-card-type"
            class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-[#f0ece6] text-[#2a2a33]"
          ></span>
          <span
            id="gm-card-mode"
            class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-[#ff6b6b]/10 text-[#ff4757]"
          ></span>
        </div>

        <!-- Nombre / titular -->
        <p
          id="gm-card-headline"
          class="text-[14px] font-semibold text-[#2a2a33] leading-snug line-clamp-2 mb-1"
        ></p>

        <!-- Ubicación -->
        <p
          id="gm-card-location"
          class="text-[12px] text-[#8a8a94] flex items-center gap-1"
        >
          <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
              clip-rule="evenodd"
            />
          </svg>
          <span id="gm-card-location-text"></span>
        </p>
      </div>

      <!-- Precio + botón -->
      <div class="flex items-center justify-between mt-3 gap-2">
        <div>
          <p
            id="gm-card-price"
            class="text-[17px] font-bold text-[#2a2a33]"
          ></p>
          <p id="gm-card-price-label" class="text-[11px] text-[#8a8a94]"></p>
        </div>
        <a
          id="gm-card-link"
          href="#"
          class="shrink-0 inline-flex items-center gap-1.5 bg-[#ff6b6b] hover:bg-[#ff4757] text-white text-[13px] font-semibold px-4 py-2 rounded-xl transition-colors"
        >
          Ver detalle
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
            />
          </svg>
        </a>
      </div>
    </div>

    <!-- Botón cerrar -->
    <button
      id="gm-card-close"
      class="absolute top-3 right-3 w-7 h-7 rounded-full bg-white/90 shadow flex items-center justify-center hover:bg-[#f0ece6] transition-colors"
      aria-label="Cerrar"
    >
      <svg
        class="w-4 h-4 text-[#2a2a33]"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"
        />
      </svg>
    </button>
  </div>
</div>

<style is:global>
  /*
   * AdvancedMarkerElement ancla el contenido por la esquina inferior-centro.
   * Estructura del marcador:
   *   ┌──────────┐
   *   │  $1.5M   │  ← píldora (precio)
   *   └────┬─────┘
   *        ▼        ← triángulo rojo
   *        • (coordenada en el mapa)
   *
   * NO usamos transform extra — AdvancedMarker ya posiciona el fondo del triángulo
   * sobre la coordenada exacta.
   */

  /* Wrapper: columna centrada, sin transform extra */
  .gm-marker-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
  }
  .gm-marker-wrap:hover .gm-price-pill,
  .gm-marker-wrap.active .gm-price-pill {
    background: #ff4757;
    color: #ffffff;
    border-color: #ff4757;
    box-shadow: 0 4px 18px rgba(255, 71, 87, 0.5);
  }
  .gm-marker-wrap:hover .gm-marker-tip,
  .gm-marker-wrap.active .gm-marker-tip {
    border-top-color: #cc2233;
  }

  /* Píldora: precio abreviado sobre fondo blanco */
  .gm-price-pill {
    font-family: "Poppins", sans-serif;
    font-size: 12px;
    font-weight: 700;
    background: #ffffff;
    color: #2a2a33;
    padding: 4px 11px;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.22);
    border: 2px solid #ff4757;
    white-space: nowrap;
    user-select: none;
    line-height: 1.3;
    transition:
      background 0.15s ease,
      color 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  /* Triángulo justo debajo de la píldora — apunta hacia la coordenada */
  .gm-marker-tip {
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 8px solid #ff4757;
    /* sin margen-top para que quede pegado a la píldora */
    transition: border-top-color 0.15s ease;
  }

  /* ── Tarjeta de inmueble seleccionado ───────────────────────────────── */
  #gm-property-card {
    position: relative;
    animation: gm-slide-up 0.22s cubic-bezier(0.4, 0, 0.2, 1);
  }
  @keyframes gm-slide-up {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<!-- Datos serializados por Astro para el script cliente -->
<script
  id="general-map-data"
  type="application/json"
  set:html={JSON.stringify(properties)}
/>
<script>
  // ─── Estado del módulo ───────────────────────────────────────────────────────
  let _mapInst: any = null
  let _markers: any[] = []
  let _mapsLibLoaded = false
  let _Map: any, _LatLngBounds: any, _AdvancedMarker: any
  let _activePill: HTMLElement | null = null // píldora actualmente seleccionada

  // ─── Carga del SDK de Google Maps (una sola vez por página) ─────────────────
  async function loadMapsLibs(apiKey: string): Promise<boolean> {
    if (_mapsLibLoaded) return true
    try {
      if (!(window as any).google?.maps) {
        await new Promise<void>((resolve, reject) => {
          if (document.getElementById("gmap-script")) {
            const wait = setInterval(() => {
              if ((window as any).google?.maps) {
                clearInterval(wait)
                resolve()
              }
            }, 80)
            setTimeout(() => {
              clearInterval(wait)
              reject(new Error("timeout"))
            }, 12000)
            return
          }
          const s = document.createElement("script")
          s.id = "gmap-script"
          s.src = `https://maps.googleapis.com/maps/api/js?key=${apiKey}&libraries=maps,marker&v=beta`
          s.async = true
          s.onload = () => resolve()
          s.onerror = () => reject(new Error("script load failed"))
          document.head.appendChild(s)
        })
      }
      const g = (window as any).google.maps
      _Map = g.Map
      _LatLngBounds = g.LatLngBounds
      _AdvancedMarker = g.marker?.AdvancedMarkerElement ?? null
      _mapsLibLoaded = true
      return true
    } catch (err) {
      console.error("[MapComponent] Error cargando Google Maps:", err)
      return false
    }
  }

  // ─── Limpiar marcadores ──────────────────────────────────────────────────────
  function clearMarkers() {
    _markers.forEach((m) => {
      if (m && m.map !== undefined) m.map = null
      else if (m && typeof m.setMap === "function") m.setMap(null)
    })
    _markers = []
    _activePill = null
  }

  // ─── Abreviar precio: $ 1.500.000 → $1.5M | $ 950.000 → $950k ──────────────
  function abbreviatePrice(raw: string): string {
    // Extraer solo los dígitos del precio formateado
    const digits = raw.replace(/[^\d]/g, "")
    const n = parseInt(digits, 10)
    if (isNaN(n)) return raw
    if (n >= 1_000_000_000)
      return `$${(n / 1_000_000_000).toFixed(1).replace(/\.0$/, "")}B`
    if (n >= 1_000_000)
      return `$${(n / 1_000_000).toFixed(1).replace(/\.0$/, "")}M`
    if (n >= 1_000) return `$${(n / 1_000).toFixed(0)}k`
    return raw
  }

  // ─── Crear marcador HTML: píldora + triángulo apuntando al pin ───────────────
  function makeMarkerEl(label: string): HTMLElement {
    const wrap = document.createElement("div")
    wrap.className = "gm-marker-wrap"

    const pill = document.createElement("div")
    pill.className = "gm-price-pill"
    pill.textContent = abbreviatePrice(label)

    const tip = document.createElement("div")
    tip.className = "gm-marker-tip"

    wrap.appendChild(pill)
    wrap.appendChild(tip)
    return wrap
  }

  // ─── Mostrar tarjeta de inmueble debajo del mapa ─────────────────────────────
  function showPropertyCard(item: any, markerEl: HTMLElement) {
    // Resaltar el marcador activo
    if (_activePill && _activePill !== markerEl) {
      _activePill.classList.remove("active")
    }
    markerEl.classList.add("active")
    _activePill = markerEl

    const card = document.getElementById(
      "gm-property-card",
    ) as HTMLElement | null
    if (!card) return

    // Foto
    const photoEl = card.querySelector(
      "#gm-card-photo",
    ) as HTMLImageElement | null
    const noPhotoEl = card.querySelector(
      "#gm-card-no-photo",
    ) as HTMLElement | null
    if (photoEl) {
      if (item.photo) {
        photoEl.src = item.photo
        photoEl.style.display = ""
        if (noPhotoEl) noPhotoEl.classList.add("hidden")
      } else {
        photoEl.style.display = "none"
        if (noPhotoEl) noPhotoEl.classList.remove("hidden")
      }
    }

    // Tipo e inmueble
    const typeEl = card.querySelector("#gm-card-type") as HTMLElement | null
    if (typeEl) typeEl.textContent = item.type || "Inmueble"

    // Modo (Arriendo / Venta)
    const modeEl = card.querySelector("#gm-card-mode") as HTMLElement | null
    if (modeEl) {
      modeEl.textContent = item.mode === "sale" ? "Venta" : "Arriendo"
    }

    // Titular / headline
    const headlineEl = card.querySelector(
      "#gm-card-headline",
    ) as HTMLElement | null
    if (headlineEl)
      headlineEl.textContent =
        item.headline ||
        `${item.type || "Inmueble"} en ${item.neighborhood || item.city}`

    // Ubicación
    const locEl = card.querySelector(
      "#gm-card-location-text",
    ) as HTMLElement | null
    if (locEl) {
      const parts = [item.neighborhood, item.city].filter(Boolean)
      locEl.textContent = parts.join(", ")
    }

    // Precio
    const priceEl = card.querySelector("#gm-card-price") as HTMLElement | null
    if (priceEl) priceEl.textContent = item.formattedPrice || `$ ${item.price}`
    const priceLabelEl = card.querySelector(
      "#gm-card-price-label",
    ) as HTMLElement | null
    if (priceLabelEl)
      priceLabelEl.textContent =
        item.mode === "sale" ? "Precio de venta" : "Canon mensual"

    // Enlace
    const linkEl = card.querySelector(
      "#gm-card-link",
    ) as HTMLAnchorElement | null
    if (linkEl) linkEl.href = `/property/${item.code}`

    // Mostrar con animación
    card.classList.remove("hidden")
    card.scrollIntoView({ behavior: "smooth", block: "nearest" })
  }

  // ─── Ocultar tarjeta ─────────────────────────────────────────────────────────
  function hidePropertyCard() {
    const card = document.getElementById(
      "gm-property-card",
    ) as HTMLElement | null
    if (card) card.classList.add("hidden")
    if (_activePill) {
      _activePill.classList.remove("active")
      _activePill = null
    }
  }

  // ─── Función principal: inicializar o re-renderizar el mapa ─────────────────
  async function renderGeneralMap() {
    const mapEl = document.getElementById(
      "general-locations-map",
    ) as HTMLElement | null
    if (!mapEl) return

    // Si el contenedor está oculto no hacer nada (lo llama triggerGeneralMapResize al mostrarse)
    const rect = mapEl.getBoundingClientRect()
    if (rect.width === 0 || rect.height === 0) return

    const apiKey = mapEl.dataset.apiKey || ""
    const ok = await loadMapsLibs(apiKey)
    if (!ok) return

    // Leer datos serializados por Astro
    const dataEl = document.getElementById("general-map-data")
    const items: any[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : []

    // Crear mapa si no existe
    if (!_mapInst) {
      _mapInst = new _Map(mapEl, {
        center: { lat: 6.2442, lng: -75.5812 },
        zoom: 6,
        mapId: "DEMO_MAP_ID",
        mapTypeControl: false,
        streetViewControl: false,
        fullscreenControl: true,
        zoomControl: true,
        clickableIcons: false,
      })

      // Clic en el mapa cierra la tarjeta
      _mapInst.addListener("click", () => hidePropertyCard())
    }

    // Trigger resize para que el canvas ocupe el tamaño correcto
    ;(window as any).google.maps.event.trigger(_mapInst, "resize")

    // Limpiar marcadores anteriores y cerrar tarjeta
    clearMarkers()
    hidePropertyCard()

    const bounds = new _LatLngBounds()
    let hasCoords = false
    const existingCodes = new Set<string>()

    function addMarkerItem(item: any) {
      if (!item || !item.code || existingCodes.has(String(item.code))) return
      const lat = Number(item.lat)
      const lng = Number(item.lng)
      if (!lat || !lng || isNaN(lat) || isNaN(lng)) return

      existingCodes.add(String(item.code))
      const pos = { lat, lng }
      bounds.extend(pos)
      hasCoords = true

      const label =
        item.formattedPrice || (item.price ? `$ ${item.price}` : "Sin precio")
      const markerEl = makeMarkerEl(label)

      let marker: any = null

      if (_AdvancedMarker) {
        try {
          marker = new _AdvancedMarker({
            map: _mapInst,
            position: pos,
            content: markerEl,
            title: `${item.type || "Inmueble"} · ${item.neighborhood || item.city || ""}`,
          })
          marker.addListener("click", () => showPropertyCard(item, markerEl))
        } catch (_e) {
          marker = null
        }
      }

      if (!marker) {
        const g = (window as any).google.maps
        const shortLabel = abbreviatePrice(label)
        try {
          marker = new g.Marker({
            position: pos,
            map: _mapInst,
            title: label,
            icon: {
              path: g.SymbolPath.CIRCLE,
              scale: 7,
              fillColor: "#ff4757",
              fillOpacity: 1,
              strokeColor: "#ffffff",
              strokeWeight: 2,
              anchor: new g.Point(0, 0),
              labelOrigin: new g.Point(0, -28),
            },
            label: {
              text: shortLabel,
              color: "#2a2a33",
              fontFamily: "Poppins, sans-serif",
              fontSize: "11px",
              fontWeight: "700",
            },
          })
          marker.addListener("click", () => showPropertyCard(item, markerEl))
        } catch (_e) {
          marker = null
        }
      }

      if (marker) _markers.push(marker)
    }

    // Agregar lote inicial rápido
    items.forEach((item: any) => addMarkerItem(item))

    // Carga progresiva de todos los inmuebles de la API en segundo plano
    let isFetchingAll = false
    async function loadAllPropertiesProgressively() {
      if (isFetchingAll) return
      isFetchingAll = true
      let currentPage = 1
      let totalPages = 1
      const mode =
        new URL(window.location.href).searchParams.get("mode") || "rent"

      try {
        while (currentPage <= totalPages && currentPage <= 15) {
          // carga hasta 15 páginas progresivas
          const res = await fetch(
            `/api/mapProperties?mode=${mode}&page=${currentPage}&perPage=30`,
          )
          if (!res.ok) break
          const data = await res.json()
          if (!data.items || data.items.length === 0) break

          totalPages = data.totalPages || 1
          data.items.forEach((item: any) => addMarkerItem(item))

          currentPage++
          // Pausa suave de 120ms entre tandas para que el navegador no se trabe
          await new Promise((resolve) => setTimeout(resolve, 120))
        }
      } catch (e) {
        console.warn("Carga progresiva detenida:", e)
      } finally {
        isFetchingAll = false
      }
    }

    setTimeout(() => {
      loadAllPropertiesProgressively()
    }, 400)

    // Ajustar viewport a todos los marcadores
    if (hasCoords) {
      _mapInst.fitBounds(bounds, 50)
      ;(window as any).google.maps.event.addListenerOnce(
        _mapInst,
        "idle",
        () => {
          if (_mapInst.getZoom() > 16) _mapInst.setZoom(15)
        },
      )
    }
  }

  // ─── API pública ─────────────────────────────────────────────────────────────
  ;(window as any).triggerGeneralMapResize = function () {
    if (_mapInst) {
      const mapEl = document.getElementById("general-locations-map")
      if (mapEl) {
        const rect = mapEl.getBoundingClientRect()
        if (rect.width === 0 || rect.height === 0) {
          _mapInst = null // forzar recreación con tamaño correcto
        }
      }
    }
    renderGeneralMap()
  }

  // Botón cerrar tarjeta
  document.addEventListener("DOMContentLoaded", () => {
    const closeBtn = document.getElementById("gm-card-close")
    if (closeBtn) closeBtn.addEventListener("click", hidePropertyCard)
  })

  // Intentar render al cargar (solo si el contenedor ya es visible)
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => renderGeneralMap())
  } else {
    renderGeneralMap()
  }
  document.addEventListener("astro:page-load", () => {
    const closeBtn = document.getElementById("gm-card-close")
    if (closeBtn && !closeBtn.dataset.bound) {
      closeBtn.dataset.bound = "true"
      closeBtn.addEventListener("click", hidePropertyCard)
    }
    renderGeneralMap()
  })
</script>
