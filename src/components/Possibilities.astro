---
const tarjetas = [
  {
    etiqueta: "QUIERO COMPRAR",
    titulo: "Un hogar que se ajuste a mi presupuesto.",
    texto:
      "Calcula un precio orientativo con tu cuota y tus ahorros. Lleva el resultado a tu búsqueda.",
    enlace: "Calcular mi presupuesto →",
    href: "/search?mode=sale",
    fondo: "bg-[#e5eff6]",
    btnFondo: "bg-[#fef2c9] text-[#73581c] hover:bg-[#faeab5]",
  },
  {
    etiqueta: "SOY PROPIETARIO",
    titulo: "Anticipa hasta 10 meses de canon.",
    texto:
      "Solicita liquidez con tu inmueble ya arrendado. El anticipo no aplica durante la vacancia.",
    enlace: "Conocer mi anticipo →",
    href: "/promote-rent",
    fondo: "bg-[#fef2c9]",
    btnFondo: "bg-[#e5eff6] text-[#24507b] hover:bg-[#d6e7f4]",
  },
]

const accesos = [
  { texto: "Mi espacio propietario", href: "/self-management" },
  { texto: "Calcular mi primer pago", href: "/pay-rent" },
  { texto: "Mantenimientos Inmobiliarios", href: "/pqrs" },
  { texto: "¿En qué va mi solicitud?", href: "/self-management" },
]

const enlaceEncabezado = { texto: "Ver financiación", href: "/pqrs" }
---

<section
  aria-labelledby="titulo-posibilidades"
  class="seccion-puertas mx-auto w-full max-w-[1760px] bg-white px-5 pb-[clamp(40px,7vh,80px)] sm:px-8 lg:px-[8.2%]"
>
  <div class="rounded-[28px] border border-slate-200 bg-white p-6 sm:p-[38px]">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-[11px] font-medium uppercase tracking-[0.22em] text-slate-500">
          Tus planes, más cerca
        </p>
        <h2
          id="titulo-posibilidades"
          class="mt-3 text-[length:clamp(26px,2.6vw,40px)] font-normal leading-[1.15] tracking-tight text-slate-800"
        >
          Tu inmueble también abre posibilidades.
        </h2>
      </div>

      <a
        href={enlaceEncabezado.href}
        class="shrink-0 inline-flex items-center rounded-xl bg-[#fef2c9] px-4 py-2.5 text-[13px] font-medium text-[#73581c] transition-colors hover:bg-[#faeab5]"
      >
        {enlaceEncabezado.texto} →
      </a>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2">
      {tarjetas.map((t) => (
        <article
          class={`flex min-h-[260px] flex-col rounded-[24px] p-7 sm:p-9 ${t.fondo}`}
        >
          <p class="text-[10.5px] font-medium uppercase tracking-[0.2em] text-slate-600">
            {t.etiqueta}
          </p>
          <h3 class="mt-5 text-[length:clamp(22px,2vw,30px)] font-normal leading-[1.25] text-slate-800">
            {t.titulo}
          </h3>
          <p class="mt-3 max-w-[480px] text-[13.5px] leading-[1.7] text-slate-600">
            {t.texto}
          </p>
          <a
            href={t.href}
            class={`mt-auto pt-7 inline-flex w-fit items-center rounded-xl px-4 py-2.5 text-[13px] font-medium transition-colors ${t.btnFondo}`}
          >
            {t.enlace}
          </a>
        </article>
      ))}
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      {accesos.map((a) => (
        <a
          href={a.href}
          class="inline-flex h-[40px] items-center rounded-full border border-slate-200 px-4 text-[12.5px] text-slate-800 transition-colors hover:border-slate-300 hover:bg-slate-50"
        >
          {a.texto} →
        </a>
      ))}
    </div>
  </div>
</section>
