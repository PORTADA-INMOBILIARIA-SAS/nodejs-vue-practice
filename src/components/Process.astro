---
const pasos = [
  {
    numero: "01",
    titulo: "Encuentra y visita",
    texto: "Explora el catálogo y conoce tu próximo lugar.",
    linea: "border-[#e6e0d6]",
  },
  {
    numero: "02",
    titulo: "Prepara tu estudio",
    texto: "Consulta los requisitos según tu perfil.",
    linea: "border-[#bcd6e8]",
  },
  {
    numero: "03",
    titulo: "Revisa y firma",
    texto: "Revisa el contrato y la firma de ejemplo.",
    linea: "border-[#f2db8c]",
  },
  {
    numero: "04",
    titulo: "Realiza tu pago",
    texto: "Consulta el valor y tu comprobante.",
    linea: "border-[#f4a39d]",
  },
  {
    numero: "05",
    titulo: "Recibe las llaves",
    texto: "Coordina la entrega y revisa el inventario.",
    linea: "border-[#a9cfc4]",
  },
]

const etapas = [
  { texto: "Encontrar", href: "/search" },
  { texto: "Habitar", href: "/pay-rent" },
  { texto: "Cuidar", href: "/Autogestion" },
]

const enlaceEncabezado = {
  texto: "Conocer el proceso completo",
  href: "/services",
}
const enlaceEtapas = { texto: "Quiero conocerlas", href: "/pqrs" }
---

<section
  aria-labelledby="titulo-proceso"
  class="seccion-proceso mx-auto w-full max-w-[1580px] bg-white px-5 pb-16 sm:px-8 lg:px-0 lg:pb-[100px]"
  style="--escala: 0.8"
>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-[11px] font-medium uppercase tracking-[0.25em] text-[#6b6b75]">
        Paso a paso, contigo
      </p>
      <h2
        id="titulo-proceso"
        class="mt-5 text-[28px] font-normal leading-[1.15] tracking-[-0.03em] text-[#1e1e24] sm:text-[34px] lg:text-[42px]"
      >
        Del primer clic a tus nuevas llaves.
      </h2>
    </div>

    <a
      href={enlaceEncabezado.href}
      class="shrink-0 text-[15px] text-[#1e1e24] hover:underline sm:pt-9"
    >
      {enlaceEncabezado.texto} →
    </a>
  </div>

  <ol class="mt-14 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-5">
    {pasos.map((paso) => (
      <li class={`border-t-2 pt-9 ${paso.linea}`}>
        <span class="text-[15px] text-[#6b6b75]">{paso.numero}</span>
        <h3 class="mt-8 text-[20px] font-normal text-[#1e1e24]">
          {paso.titulo}
        </h3>
        <p class="mt-4 text-[15px] leading-[26px] text-[#55555e]">
          {paso.texto}
        </p>
      </li>
    ))}
  </ol>

  <div class="mt-20 border-t border-[#ece6dc] pb-6 pt-14 text-center">
    <p class="text-[11.5px] font-medium uppercase tracking-[0.25em] text-[#6b6b75]">
      Contigo en cada etapa
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 sm:gap-x-12 lg:gap-x-[72px]">
      {etapas.map((etapa) => (
        <span class="text-[26px] font-normal tracking-[-0.02em] text-[#1e1e24] sm:text-[32px] lg:text-[40px]">
          {etapa.texto}
        </span>
      ))}
    </div>

    <p class="mt-8 text-[14px] text-[#55555e]">
      Explora el diseño de las alternativas para tu inmueble.{" "}
      <a
        href={enlaceEtapas.href}
        class="text-[#1e1e24] underline decoration-[#cfcac0] underline-offset-4 transition-colors hover:decoration-[#1e1e24]"
      >
        {enlaceEtapas.texto} →
      </a>
    </p>
  </div>
</section>

<style is:global>
  .seccion-proceso,
  .seccion-proceso * {
    font-family: "Poppins", sans-serif;
  }
  @media (min-width: 1024px) {
    .seccion-proceso {
      zoom: var(--escala, 1);
    }
  }
</style>
