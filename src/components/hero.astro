---
const RUTA_BUSQUEDA = "/search"
const RUTA_PUBLICAR = "/promote-property"

const ciudadesConBarrios = [
  {
    nombre: "Medellín",
    barrios: [
      "El Poblado",
      "Laureles",
      "Belén",
      "Conquistadores",
      "Los Colores",
      "Estadio",
      "Calasanz",
      "Robledo",
      "Buenos Aires",
      "Boston",
      "Castilla",
      "Guayabal",
      "San Javier",
      "La América",
      "Prado",
    ],
  },
  {
    nombre: "Envigado",
    barrios: [
      "La Magnolia",
      "Zúñiga",
      "Las Orquídeas",
      "San Marcos",
      "Jardines",
      "Pontevedra",
      "El Esmeraldal",
      "Loma del Chocho",
      "Loma de las Brujas",
      "El Dorado",
    ],
  },
  {
    nombre: "Bello",
    barrios: [
      "Cabañas",
      "Cabañitas",
      "Niquía",
      "Amazonia",
      "Barrio Mesa",
      "El Trapiche",
      "Santa Ana",
    ],
  },
  {
    nombre: "Sabaneta",
    barrios: [
      "Aves María",
      "Calle Larga",
      "Calle del Banco",
      "Carmelo",
      "Doctor Changa",
      "La Florida",
      "San José",
    ],
  },
  {
    nombre: "Itagüí",
    barrios: [
      "Santa María",
      "Ditaires",
      "San Fernando",
      "La Glorieta",
      "La Finca",
      "San Pío",
    ],
  },
  {
    nombre: "Rionegro",
    barrios: ["San Antonio de Pereira", "El Porvenir", "Llanogrande"],
  },
  {
    nombre: "Bogotá",
    barrios: ["Chapinero", "Usaquén", "Cedritos", "Suba", "Teusaquillo"],
  },
]

const presupuestos: Record<string, { valor: string; texto: string }[]> = {
  rent: [
    { valor: "", texto: "Sin límite" },
    { valor: "1500000", texto: "Hasta $ 1.500.000" },
    { valor: "2500000", texto: "Hasta $ 2.500.000" },
    { valor: "3500000", texto: "Hasta $ 3.500.000" },
    { valor: "5000000", texto: "Hasta $ 5.000.000" },
    { valor: "8000000", texto: "Hasta $ 8.000.000" },
  ],
  sale: [
    { valor: "", texto: "Sin límite" },
    { valor: "200000000", texto: "Hasta $ 200.000.000" },
    { valor: "400000000", texto: "Hasta $ 400.000.000" },
    { valor: "600000000", texto: "Hasta $ 600.000.000" },
    { valor: "1000000000", texto: "Hasta $ 1.000.000.000" },
    { valor: "2000000000", texto: "Hasta $ 2.000.000.000" },
  ],
}
---

<section
  id="hero-section"
  class="relative flex min-h-[calc(100svh-88px)] w-full items-center overflow-hidden bg-slate-200 lg:h-[calc(100svh-88px)] lg:min-h-[640px]"
  style="contain:layout style"
>
  <picture class="absolute inset-0 h-full w-full">
    <source
      media="(max-width: 640px)"
      srcset="/img/img1-mobile.webp"
      type="image/webp"
      width="640"
      height="427"
    />
    <img
      src="/img/img1.webp"
      alt="Familia compartiendo el desayuno en casa"
      class="h-full w-full object-cover object-center"
      width="1440"
      height="960"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </picture>

  <!-- Tarjeta de Búsqueda Flotante -->
  <div class="relative z-10 w-full px-4 py-8 sm:px-8 lg:px-0 lg:py-0">
    <div class="w-full max-w-[540px] rounded-[32px] bg-white px-7 py-8 shadow-2xl sm:px-10 sm:py-9 lg:ml-[8%]">
      <!-- Pestañas Superiores (Nivel 1): Buscar inmuebles / Publicar mi inmueble -->
      <div class="flex items-center gap-7 border-b border-[#f0ece5]">
        <button
          type="button"
          id="tab-top-buscar"
          class="relative pb-3 text-[15px] font-medium text-[#1e1e24] transition-colors"
        >
          Buscar inmuebles
          <span class="absolute bottom-0 left-0 h-[2.5px] w-full rounded-full bg-[#f4a39d]"></span>
        </button>

        <a
          href={RUTA_PUBLICAR}
          id="tab-top-publicar"
          class="pb-3 text-[15px] font-normal text-[#75716b] transition-colors hover:text-[#1e1e24]"
        >
          Publicar mi inmueble
        </a>
      </div>

      <!-- Título Dinámico -->
      <h1
        id="hero-search-title"
        class="mt-7 text-[length:clamp(32px,3.2vw,44px)] font-light leading-[1.12] tracking-tight text-[#1e1e24]"
      >
        Arrienda un hogar para llamar tuyo
      </h1>

      <!-- Pestañas de Modalidad (Nivel 2): Arrendar / Comprar -->
      <div class="mt-6 flex items-center gap-6 border-b border-[#f0ece5]">
        <button
          type="button"
          data-mode="rent"
          class="mode-btn relative pb-2 text-[14px] font-medium text-[#1e1e24] transition-colors"
        >
          Arrendar
          <span class="mode-indicator absolute bottom-0 left-0 h-[2px] w-full rounded-full bg-[#f4a39d]"></span>
        </button>
        <button
          type="button"
          data-mode="sale"
          class="mode-btn relative pb-2 text-[14px] font-normal text-[#75716b] transition-colors hover:text-[#1e1e24]"
        >
          Comprar
          <span class="mode-indicator absolute bottom-0 left-0 hidden h-[2px] w-full rounded-full bg-[#f4a39d]"></span>
        </button>
      </div>

      <!-- Formulario de Búsqueda -->
      <form
        id="form-busqueda"
        action={RUTA_BUSQUEDA}
        method="get"
        class="mt-6 flex flex-col gap-4"
        data-ciudades={JSON.stringify(ciudadesConBarrios)}
        data-presupuestos={JSON.stringify(presupuestos)}
      >
        <input type="hidden" name="mode" id="input-mode" value="rent" />

        <!-- Fila 1: Ciudad y Barrio -->
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <!-- Campo Ciudad -->
          <div class="flex flex-col justify-center rounded-2xl border border-[#e8e4dc] bg-white px-4 py-2.5 transition-colors focus-within:border-[#1e1e24]">
            <label
              for="select-ciudad"
              class="text-[11.5px] font-normal text-[#75716b]"
            >
              Ciudad
            </label>
            <div class="relative flex items-center">
              <select
                id="select-ciudad"
                name="city"
                class="w-full appearance-none bg-transparent pr-6 text-[14.5px] font-normal text-[#1e1e24] outline-none cursor-pointer"
              >
                {ciudadesConBarrios.map((c) => (
                  <option value={c.nombre}>{c.nombre}</option>
                ))}
              </select>
              <svg
                class="pointer-events-none absolute right-0 h-4 w-4 text-[#75716b]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m6 9 6 6 6-6"
                />
              </svg>
            </div>
          </div>

          <!-- Campo Barrio -->
          <div class="flex flex-col justify-center rounded-2xl border border-[#e8e4dc] bg-white px-4 py-2.5 transition-colors focus-within:border-[#1e1e24]">
            <label
              for="select-barrio"
              class="text-[11.5px] font-normal text-[#75716b]"
            >
              Barrio
            </label>
            <div class="relative flex items-center">
              <select
                id="select-barrio"
                name="barrio"
                class="w-full appearance-none bg-transparent pr-6 text-[14.5px] font-normal text-[#1e1e24] outline-none cursor-pointer"
              >
                <option value="">Todos los barrios</option>
                {ciudadesConBarrios[0].barrios.map((b) => (
                  <option value={b}>{b}</option>
                ))}
              </select>
              <svg
                class="pointer-events-none absolute right-0 h-4 w-4 text-[#75716b]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m6 9 6 6 6-6"
                />
              </svg>
            </div>
          </div>
        </div>

        <!-- Fila 2: Valor máximo y Habitaciones -->
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <!-- Campo Valor Máximo -->
          <div class="flex flex-col justify-center rounded-2xl border border-[#e8e4dc] bg-white px-4 py-2.5 transition-colors focus-within:border-[#1e1e24]">
            <label
              for="select-presupuesto"
              class="text-[11.5px] font-normal text-[#75716b]"
            >
              Valor máximo
            </label>
            <div class="relative flex items-center">
              <select
                id="select-presupuesto"
                name="budget"
                class="w-full appearance-none bg-transparent pr-6 text-[14.5px] font-normal text-[#1e1e24] outline-none cursor-pointer"
              >
                {presupuestos.rent.map((p) => (
                  <option value={p.valor}>{p.texto}</option>
                ))}
              </select>
              <svg
                class="pointer-events-none absolute right-0 h-4 w-4 text-[#75716b]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m6 9 6 6 6-6"
                />
              </svg>
            </div>
          </div>

          <!-- Campo Habitaciones -->
          <div class="flex flex-col justify-center rounded-2xl border border-[#e8e4dc] bg-white px-4 py-2.5 transition-colors focus-within:border-[#1e1e24]">
            <label
              for="select-habitaciones"
              class="text-[11.5px] font-normal text-[#75716b]"
            >
              Habitaciones
            </label>
            <div class="relative flex items-center">
              <select
                id="select-habitaciones"
                name="bedrooms"
                class="w-full appearance-none bg-transparent pr-6 text-[14.5px] font-normal text-[#1e1e24] outline-none cursor-pointer"
              >
                <option value="">Cualquiera</option>
                <option value="1">1+</option>
                <option value="2">2+</option>
                <option value="3">3+</option>
                <option value="4">4+</option>
              </select>
              <svg
                class="pointer-events-none absolute right-0 h-4 w-4 text-[#75716b]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m6 9 6 6 6-6"
                />
              </svg>
            </div>
          </div>
        </div>

        <!-- Botón Principal -->
        <button
          type="submit"
          class="mt-2 flex h-[54px] w-full cursor-pointer items-center justify-center rounded-2xl bg-[#2e3040] text-[15px] font-medium text-white transition-colors hover:bg-[#1f212d]"
        >
          Buscar inmuebles
        </button>

        <!-- Acordeón / Enlace para buscar por código -->
        <div class="mt-2">
          <button
            type="button"
            id="toggle-codigo"
            class="inline-flex items-center gap-1.5 text-[12.5px] text-[#75716b] hover:text-[#1e1e24] transition-colors"
          >
            <span
              id="toggle-codigo-arrow"
              class="text-[10px] transition-transform"
            >
              ▶
            </span>
            <span>¿Tienes el código del inmueble? Búscalo aquí</span>
          </button>

          <div id="box-codigo" class="mt-2 hidden">
            <input
              type="text"
              name="code"
              placeholder="Ingresa el código (ej. P-101)"
              class="w-full rounded-xl border border-[#e8e4dc] bg-white px-3.5 py-2 text-[13px] text-[#1e1e24] outline-none placeholder:text-[#9c9890] focus:border-[#1e1e24]"
            />
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  function setupHeroSearch() {
    var form = document.getElementById("form-busqueda")
    if (!form || form.dataset.ready === "true") return
    form.dataset.ready = "true"

    var ciudades = JSON.parse(form.dataset.ciudades || "[]")
    var presupuestos = JSON.parse(form.dataset.presupuestos || "{}")
    var selectCiudad = document.getElementById("select-ciudad")
    var selectBarrio = document.getElementById("select-barrio")
    var selectPresupuesto = document.getElementById("select-presupuesto")
    var inputMode = document.getElementById("input-mode")
    var title = document.getElementById("hero-search-title")
    var modeBtns = Array.from(document.querySelectorAll(".mode-btn"))

    // Cambio de Ciudad -> actualiza lista de Barrios
    if (selectCiudad && selectBarrio) {
      selectCiudad.addEventListener("change", function () {
        var ciudadSel = selectCiudad.value
        var match = ciudades.find(function (c) {
          return c.nombre.toLowerCase() === ciudadSel.toLowerCase()
        })
        selectBarrio.innerHTML = '<option value="">Todos los barrios</option>'
        if (match && match.barrios) {
          match.barrios.forEach(function (b) {
            var opt = document.createElement("option")
            opt.value = b
            opt.textContent = b
            selectBarrio.appendChild(opt)
          })
        }
      })
    }

    // Cambio de Modalidad: Arrendar / Comprar
    modeBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var mode = btn.dataset.mode
        if (!mode) return

        modeBtns.forEach(function (b) {
          var isCurrent = b === btn
          b.classList.toggle("font-medium", isCurrent)
          b.classList.toggle("text-[#1e1e24]", isCurrent)
          b.classList.toggle("font-normal", !isCurrent)
          b.classList.toggle("text-[#75716b]", !isCurrent)
          var indicator = b.querySelector(".mode-indicator")
          if (indicator) {
            indicator.classList.toggle("hidden", !isCurrent)
          }
        })

        if (inputMode) inputMode.value = mode

        // Actualizar título
        if (title) {
          title.textContent =
            mode === "rent"
              ? "Arrienda un hogar para llamar tuyo"
              : "Compra el hogar que siempre soñaste"
        }

        // Actualizar opciones de presupuesto
        if (selectPresupuesto && presupuestos[mode]) {
          selectPresupuesto.innerHTML = ""
          presupuestos[mode].forEach(function (p) {
            var opt = document.createElement("option")
            opt.value = p.valor
            opt.textContent = p.texto
            selectPresupuesto.appendChild(opt)
          })
        }
      })
    })

    // Toggle para desplegar campo de código
    var toggleCodigo = document.getElementById("toggle-codigo")
    var boxCodigo = document.getElementById("box-codigo")
    var toggleArrow = document.getElementById("toggle-codigo-arrow")
    if (toggleCodigo && boxCodigo) {
      toggleCodigo.addEventListener("click", function () {
        var isHidden = boxCodigo.classList.contains("hidden")
        boxCodigo.classList.toggle("hidden", !isHidden)
        if (toggleArrow) {
          toggleArrow.style.transform = isHidden ? "rotate(90deg)" : ""
          toggleArrow.style.display = "inline-block"
        }
      })
    }

    // Limpieza antes de submit: si seleccionó un barrio, enviarlo como parte de la búsqueda
    form.addEventListener("submit", function () {
      var ciudad = selectCiudad ? selectCiudad.value : ""
      var barrio = selectBarrio ? selectBarrio.value : ""
      if (barrio && selectCiudad) {
        selectCiudad.value = barrio + ", " + ciudad
      }

      // Desactivar campos vacíos para que no ensucien la URL
      var inputs = Array.from(form.elements)
      inputs.forEach(function (el) {
        if ((el.tagName === "INPUT" || el.tagName === "SELECT") && !el.value) {
          el.disabled = true
        }
      })
      setTimeout(function () {
        inputs.forEach(function (el) {
          el.disabled = false
        })
      }, 100)
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupHeroSearch)
  } else {
    setupHeroSearch()
  }
</script>
