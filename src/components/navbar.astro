---
const RUTA_BUSQUEDA = "/search"
const RUTA_AUTOGESTION = "/Autogestion/"
const RUTA_SERVICIOS = "/services"

const RUTA_FINANCIACION = "/financing"

const enBusqueda = Astro.url.pathname.startsWith(RUTA_BUSQUEDA)
const esServicios = Astro.url.pathname.startsWith(RUTA_SERVICIOS)
const esAutogestion = Astro.url.pathname.startsWith("/Autogestion")
const esFinanciacionRuta = Astro.url.pathname.startsWith(RUTA_FINANCIACION)
const currentMode =
  Astro.url.searchParams.get("mode") ||
  Astro.url.searchParams.get("modalidad") ||
  ""
const esCompra =
  enBusqueda && (currentMode === "sale" || currentMode === "venta")
const esArriendo = enBusqueda && !esCompra

const enlaces = [
  {
    texto: "Arrendar",
    href: `${RUTA_BUSQUEDA}?mode=rent`,
    activo: esArriendo,
  },
  {
    texto: "Comprar",
    href: `${RUTA_BUSQUEDA}?mode=sale`,
    activo: esCompra,
  },
  { texto: "Propietarios", href: "/#propietarios", activo: false },
  {
    texto: "Financiación",
    href: RUTA_FINANCIACION,
    activo: esFinanciacionRuta,
  },
  { texto: "Nosotros y servicios", href: RUTA_SERVICIOS, activo: esServicios },
]

const esDetalle = Astro.url.pathname.startsWith("/property")

const contenedor = esDetalle
  ? "mx-auto max-w-[1700px] px-6"
  : "mx-auto max-w-[1470px] px-5"
const navegacion = esDetalle
  ? "gap-[17px] text-[14px] text-[#3a3a3a]"
  : "gap-6 text-[14px]"
const grupoBotones = "gap-3"
const boton = esDetalle
  ? "h-[54px] gap-2.5 px-6 text-[14px]"
  : "h-12 gap-2.5 px-4 text-[13px]"
const icono = "h-[22px] w-[22px]"
const alturaBarra = esDetalle ? "h-[99px]" : "h-[88px]"
---

<style is:global>
  .encabezado-portada,
  .encabezado-portada * {
    font-family: "Poppins", sans-serif;
  }
</style>

<header
  class:list={[
    "encabezado-portada fixed inset-x-0 top-0 z-50 w-full border-b bg-white",
    esDetalle ? "border-[#f2efeb]" : "border-slate-100",
  ]}
>
  {esDetalle && <div class="h-[9px] w-full bg-[#fff3c7]" aria-hidden="true" />}
  <div
    class:list={[
      "flex w-full items-center justify-between gap-6",
      alturaBarra,
      contenedor,
    ]}
  >
    <a
      href="/"
      aria-label="Portada Inmobiliaria - Inicio"
      class:list={["shrink-0 flex items-center", esDetalle && "w-[220px]"]}
    >
      <img
        src="/img/img31.webp"
        alt="Portada Inmobiliaria"
        class="h-[52px] sm:h-[60px] w-auto object-contain"
        width="400"
        height="160"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <nav
      class:list={["hidden items-center text-slate-800 lg:flex", navegacion]}
    >
      {enlaces.map((enlace) => (
        <a
          href={enlace.href}
          data-nav-link={enlace.texto.toLowerCase()}
          aria-current={enlace.activo ? "page" : undefined}
          class:list={[
            "transition-colors hover:text-red-600 font-medium text-[#2d2d34]",
            enlace.activo &&
              "text-[#9b3d33] underline decoration-[#d9534f] decoration-1 underline-offset-[6px]",
          ]}
        >
          {enlace.texto}
        </a>
      ))}
    </nav>

    <div class:list={["hidden items-center lg:flex", grupoBotones]}>
      <a
        href="/pay-rent"
        class:list={[
          "flex items-center rounded-xl font-medium transition-colors bg-[#ffaaa0] text-[#2b2b2b] hover:bg-[#ff958a]",
          boton,
        ]}
      >
        <svg
          class={icono}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"></path>
          <path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path>
        </svg>
        Paga aquí tu arriendo
      </a>

      <a
        href={RUTA_AUTOGESTION}
        class:list={[
          "flex items-center rounded-xl transition-colors font-medium border border-[#cfc9be] bg-[#faf8f5] text-[#2b2b2b] hover:border-[#ded5ca] hover:bg-white",
          boton,
        ]}
      >
        <svg
          class={icono}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="8" r="5"></circle>
          <path d="M20 21a8 8 0 0 0-16 0"></path>
        </svg>
        Autogestión
      </a>
    </div>

    <details class="relative lg:hidden">
      <summary
        aria-label="Abrir menú"
        class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 text-slate-800 [&::-webkit-details-marker]:hidden"
      >
        <svg
          class="h-6 w-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </summary>

      <div class="absolute right-0 top-full mt-3 flex w-64 flex-col gap-1 rounded-xl border border-slate-100 bg-white p-3 shadow-xl">
        {enlaces.map((enlace) => (
          <a
            href={enlace.href}
            class="rounded-lg px-3 py-2.5 text-slate-800 hover:bg-slate-50"
          >
            {enlace.texto}
          </a>
        ))}
        <a
          href="/pay-rent"
          class="mt-1 rounded-lg bg-[#f58f8f] px-3 py-2.5 text-center font-medium text-[#2e3040]"
        >
          Paga aquí tu arriendo
        </a>
        <a
          href={RUTA_AUTOGESTION}
          class="rounded-lg border border-slate-200 px-3 py-2.5 text-center text-slate-800"
        >
          Portal de autogestión
        </a>
      </div>
    </details>
  </div>
</header>

<div class={esDetalle ? "h-[109px]" : "h-[89px]"} aria-hidden="true"></div>

<script>
  function setupPropietarios() {
    function updatePropietariosActive() {
      const isPropietarios = window.location.hash === "#propietarios"
      const propLinks = document.querySelectorAll(
        '[data-nav-link="propietarios"]',
      )
      const activeClasses = [
        "text-[#9b3d33]",
        "underline",
        "decoration-[#d9534f]",
        "decoration-1",
        "underline-offset-[6px]",
      ]

      propLinks.forEach((link) => {
        if (isPropietarios) {
          link.classList.add(...activeClasses)
          link.setAttribute("aria-current", "page")
        } else {
          link.classList.remove(...activeClasses)
          link.removeAttribute("aria-current")
        }
      })
    }

    window.addEventListener("hashchange", updatePropietariosActive)
    updatePropietariosActive()

    const seccionProp = document.getElementById("propietarios")
    if (seccionProp) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              history.replaceState(null, "", "#propietarios")
              updatePropietariosActive()
            } else if (window.location.hash === "#propietarios") {
              history.replaceState(null, "", window.location.pathname)
              updatePropietariosActive()
            }
          })
        },
        { rootMargin: "-30% 0px -40% 0px" },
      )
      observer.observe(seccionProp)
    }
  }

  if ("requestIdleCallback" in window) {
    requestIdleCallback(setupPropietarios)
  } else {
    setTimeout(setupPropietarios, 200)
  }
</script>
