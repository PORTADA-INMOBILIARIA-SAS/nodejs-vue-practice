---
import type { Property } from "../../lib/propertyCatalog"
import SearchPagination from "./SearchPagination.astro"

interface Props {
  isMapView: boolean
  allItemsForMap: Property[]
  propertiesForMap: any[]
  totalPages: number
  currentPage: number
  pageNumbers: number[]
  pageLink: (page: number) => string
}

const {
  isMapView,
  allItemsForMap,
  propertiesForMap,
  totalPages,
  currentPage,
  pageNumbers,
  pageLink,
} = Astro.props

const photoUrl = (url: string) => (url ? url.replace(/=s\d+$/, "=s640") : "")
const currency = new Intl.NumberFormat("es-CO")

function getCardHeadline(property: Property): string {
  const desc = property.description?.trim() || ""
  if (desc) {
    const firstSentence = desc.split(/[.\n!]/)[0]?.trim()
    if (
      firstSentence &&
      firstSentence.length >= 14 &&
      firstSentence.length <= 60 &&
      !firstSentence.toLowerCase().startsWith("apartamento en") &&
      !firstSentence.toLowerCase().startsWith("casa en") &&
      !firstSentence.toLowerCase().startsWith("inmueble en")
    ) {
      return firstSentence.endsWith(".") ? firstSentence : `${firstSentence}.`
    }
  }
  return `${property.type} en ${property.neighborhood || property.city}`
}
---

<div id="map-view-container" class={isMapView ? "block" : "hidden"}>
  <div class="mt-6 grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
    <div class="sticky top-6 h-[480px] min-h-[480px] w-full overflow-hidden rounded-[28px] border border-[#e6e2da] bg-[#f2efe9] shadow-sm lg:h-[calc((100vh-140px)/var(--escala,1))] lg:max-h-[820px]">
      <div
        id="google-map"
        class="h-full w-full"
        data-api-key={
          import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ||
          "AIzaSyAi_z_AaYF8F08wzDeqPd4UYS9iQzWpxXk"
        }
      />
    </div>

    <div class="flex min-w-0 flex-col gap-5 overflow-y-auto max-h-[820px] pr-1">
      {allItemsForMap.map((property) => {
        const mapItem = propertiesForMap.find(
          (item) => String(item.code) === String(property.code),
        )
        const itemLat = mapItem?.lat || 0
        const itemLng = mapItem?.lng || 0

        return (
          <article
            class="property-map-card group flex cursor-pointer flex-col overflow-hidden rounded-[24px] border border-[#e6e2da] bg-white transition-all duration-200 hover:border-[#c9c4b8] hover:shadow-md sm:min-h-[148px] sm:flex-row"
            data-code={property.code}
            data-lat={itemLat}
            data-lng={itemLng}
          >
            <div class="relative aspect-[4/3] w-full shrink-0 overflow-hidden bg-[#f1eee7] sm:aspect-auto sm:w-[220px]">
              <a
                href={`/property/${property.code}`}
                class="absolute inset-0 block property-link-btn"
                aria-label={`${property.type} en ${property.neighborhood}`}
              >
                {property.photo ? (
                  <img
                    src={photoUrl(property.photo)}
                    alt={`${property.type} en ${property.neighborhood}, ${property.city}`}
                    loading="lazy"
                    decoding="async"
                    width="220"
                    height="165"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-[#e9e5dc] text-[#8a8a94] text-xs">
                    Sin foto
                  </div>
                )}
              </a>
              <button
                type="button"
                data-favorite={property.code}
                aria-pressed="false"
                aria-label="Guardar en favoritos"
                class="group/fav absolute right-3 top-3 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-white/95 text-[#2a2a33] shadow-sm transition-colors hover:bg-white"
              >
                <svg
                  class="h-5 w-5 group-aria-pressed/fav:fill-[#ef6f6f] group-aria-pressed/fav:text-[#ef6f6f]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                </svg>
              </button>
            </div>

            <div class="flex min-w-0 flex-1 flex-col justify-between px-4 py-5">
              <div>
                <p class="truncate text-[13px] font-normal text-[#6b6b75]">
                  {property.neighborhood} · {property.city}
                </p>
                <h3 class="mt-1 line-clamp-1 text-[16px] font-medium leading-snug text-[#2a2a33] sm:text-[17px]">
                  <a
                    href={`/property/${property.code}`}
                    class="hover:underline property-link-btn"
                  >
                    {getCardHeadline(property)}
                  </a>
                </h3>
                <p class="mt-2 text-[13px] text-[#5e5e68]">
                  {[
                    property.area > 0 ? `${property.area} m²` : null,
                    property.bedrooms > 0 ? `${property.bedrooms} alc.` : null,
                    property.bathrooms > 0
                      ? `${property.bathrooms} baños`
                      : null,
                    property.parking > 0 ? `${property.parking} parq.` : null,
                  ]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
              </div>

              <div class="mt-4 flex items-baseline gap-1.5">
                <span class="text-[20px] font-semibold text-[#2a2a33]">
                  $ {currency.format(property.price)}
                </span>
                {property.mode === "rent" && (
                  <span class="text-[13px] font-normal text-[#6b6b75]">
                    / mes
                  </span>
                )}
              </div>
            </div>
          </article>
        )
      })}

      <SearchPagination
        currentPage={currentPage}
        totalPages={totalPages}
        pageNumbers={pageNumbers}
        pageLink={pageLink}
      />
    </div>
  </div>
</div>

<script
  id="map-properties-data"
  type="application/json"
  set:html={JSON.stringify(propertiesForMap)}
/>
