---
import Footer from "../components/footer.astro"
import "../styles/global.css"

interface Props {
  title: string
  description?: string
  showFooter?: boolean
}

const {
  title,
  description = "Portada Inmobiliaria SAS – Encuentra apartamentos, casas y locales en arriendo y venta en Medellín, Envigado, Sabaneta y más ciudades.",
  showFooter = true,
} = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
    <link
      rel="preload"
      href="/font/RobotoCondensed-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/font/poppins-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen 2xl:text-lg bg-white">
    <slot />
    {showFooter && (
      <div style="content-visibility:auto;contain-intrinsic-size:0 500px">
        <Footer />
      </div>
    )}
    <style is:global>
      @font-face {
        font-family: "RobotoCondensed-Regular";
        src: url("/font/RobotoCondensed-Regular.woff2") format("woff2");
        font-display: swap;
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Poppins";
        font-style: normal;
        font-weight: 300;
        font-display: swap;
        src: url("/font/poppins-300.woff2") format("woff2");
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Poppins";
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("/font/poppins-400.woff2") format("woff2");
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Poppins";
        font-style: normal;
        font-weight: 500;
        font-display: swap;
        src: url("/font/poppins-500.woff2") format("woff2");
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: "Poppins";
        font-style: normal;
        font-weight: 600;
        font-display: swap;
        src: url("/font/poppins-600.woff2") format("woff2");
        unicode-range:
          U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
          U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
          U+2212, U+2215, U+FEFF, U+FFFD;
      }

      :root {
        --primary-color: rgba(209, 17, 22);
        --primary-color-75: rgba(209, 17, 22, 0.75);
        --primary-color-50: rgba(209, 17, 22, 0.5);
        --primary-color-25: rgba(209, 17, 22, 0.25);

        --cyan-color: rgba(0, 159, 227);
        --cyan-color-75: rgba(0, 159, 227, 0.75);
        --cyan-color-50: rgba(0, 159, 227, 0.5);
        --cyan-color-25: rgba(0, 159, 227, 0.25);

        --yellow-color: rgba(255, 237, 0);
        --yellow-color-75: rgba(255, 237, 0.75);
        --yellow-color-50: rgba(255, 237, 0.5);
        --yellow-color-25: rgba(255, 237, 0.25);
      }

      * {
        font-family: "RobotoCondensed-Regular", sans-serif;
      }

      body {
        background-color: #ffffff;
      }

      select {
        -moz-appearance: none;
        -webkit-appearance: none;
        -ms-appearance: none;
        -o-appearance: none;
        appearance: none;
      }

      input[type="range"]::-webkit-slider-thumb {
        width: 18px;
        -webkit-appearance: none;
        height: 18px;
        background: var(--primary-color);
        border-radius: 100%;
      }

      .unselectable {
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        -khtml-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
      }
    </style>
  </body>
</html>
