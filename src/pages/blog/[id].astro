---
export const prerender = false

import Layout from "../../layouts/Layout.astro"

const { id } = Astro.params

let postData: any = null
let unavailable = false

try {
  const base = "https://portadainmobiliaria.com/wp-json/wp/v2/posts"
  const url = /^\d+$/.test(id || "")
    ? `${base}/${encodeURIComponent(id || "")}`
    : `${base}?slug=${encodeURIComponent(id || "")}`
  const response = await fetch(url)
  if (!response.ok && response.status !== 404)
    throw new Error(`WordPress: ${response.status}`)
  if (response.ok) {
    const data = await response.json()
    postData = Array.isArray(data) ? data[0] : data
  }
} catch (error) {
  console.error("No se pudo consultar el blog de WordPress:", error)
  unavailable = true
}

if (!postData) Astro.response.status = unavailable ? 503 : 404
---

<Layout
  title={
    postData
      ? `${postData.title.rendered} - Portada Inmobiliaria`
      : "Blog - Portada Inmobiliaria"
  }
>
  <div class="mx-4 pt-28 flex justify-center">
    <div class="w-[80%] mt-20">
      {postData ? (
        <>
          <div class="mb-10">
            <h1 class="text-[--primary-color] font-bold text-3xl text-center">
              {postData.title.rendered}
            </h1>
          </div>
          <div set:html={postData.content.rendered} class="post-info mb-20" />
        </>
      ) : (
        <p class="mb-20 text-center">
          {unavailable
            ? "El blog no está disponible en este momento. Inténtalo de nuevo más tarde."
            : "No se encontró el artículo solicitado."}{" "}
          <a href="/blog">Volver al blog</a>.
        </p>
      )}
    </div>
  </div>
</Layout>

<style is:inline>
  h2 {
    font-size: 1.4rem;
    color: var(--primary-color);
    font-weight: bolder;
    margin: 15px;
  }

  .post-info {
    font-size: 1.1rem;
    text-align: justify;
  }
</style>
