---
import Layout from "../layouts/Layout.astro"
---

<Layout title="Portal de Recaudos - Cundinamarca | Portada Inversiones">
  <main class="w-full h-screen overflow-hidden bg-white flex flex-col lg:flex-row font-sans">
    <div class="lg:w-1/2 w-full h-48 lg:h-full bg-slate-50 flex items-center justify-center relative overflow-hidden shrink-0">
      <img
        src="/img/img32.webp"
        alt="Portal de Recaudos Cundinamarca"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="lg:w-1/2 w-full h-full flex flex-col items-center justify-between p-6 sm:p-10 lg:p-12 bg-white overflow-y-auto">
      <div class="max-w-md w-full flex flex-col items-center text-center my-auto">
        <div class="mb-6 w-full flex justify-center">
          <a href="/pagar-arriendo" class="cursor-pointer">
            <img
              src="/img/img33.webp"
              alt="Portada Inversiones"
              class="w-[150px] sm:w-[180px] h-auto object-contain"
            />
          </a>
        </div>

        <h1 class="text-2xl sm:text-3xl font-extrabold text-[#0d1b2a] tracking-tight mb-2 leading-snug">
          Bienvenido al Sistema de Recaudos
        </h1>
        <p class="text-sm text-[#475569] mb-6 font-normal">
          Realiza pagos de manera segura
        </p>

        <h2 class="text-xs font-extrabold text-[#0f172a] uppercase tracking-wider mb-3">
          Validación de usuario
        </h2>

        <form id="form-recaudo-cundinamarca" class="w-full space-y-4">
          <div class="relative w-full">
            <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-slate-500">
              <svg
                class="w-5 h-5 text-slate-500"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                />
              </svg>
            </span>
            <input
              type="text"
              required
              placeholder="Número de documento"
              class="w-full pl-11 pr-4 py-3 bg-white border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-slate-700 focus:border-slate-700 transition-all shadow-sm"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-[#0d1b2a] hover:bg-[#1b263b] text-white font-extrabold text-xs uppercase tracking-widest py-3.5 rounded-lg transition-all cursor-pointer shadow-md"
          >
            INICIAR SESIÓN
          </button>
        </form>

        <script>
          const form_cundinamarca = document.getElementById(
            "form-recaudo-cundinamarca",
          )
          function handleSubmit(e: Event) {
            e.preventDefault()
            alert("Validación de usuario en proceso para Cundinamarca")
          }
          form_cundinamarca?.addEventListener("submit", handleSubmit)
        </script>

        <div class="mt-8 flex flex-col items-center space-y-3 w-full">
          <div class="flex items-center justify-center gap-2 text-sm font-bold text-[#4012AB]">
            <svg
              width="22"
              height="22"
              viewBox="0 0 29 28"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              class="shrink-0"
            >
              <path
                d="M27.2411 15.2449C27.2411 15.2449 28.7877 12.5442 28.1727 10.5782C28.1475 10.4956 28.1188 10.4164 28.0919 10.3372C28.064 10.2614 28.0363 10.1873 28.006 10.1132C27.2916 8.37453 25.6018 7.23228 23.7267 7.10761L21.4119 6.9543L21.2586 4.63947C21.1339 2.76436 19.9917 1.07457 18.253 0.360247C18.1789 0.329922 18.1048 0.301281 18.029 0.274326C17.9498 0.24737 17.8706 0.218729 17.788 0.193458C15.822 -0.42147 13.1213 1.12512 13.1213 1.12512L0.366211 7.80003C1.53036 9.98176 4.17371 10.8747 6.40767 9.88573C6.4481 9.97671 6.49022 10.066 6.53739 10.1553C7.70997 12.3977 10.4392 13.2973 12.7069 12.2241C12.8113 13.0615 13.182 13.8718 13.8239 14.5137C14.4657 15.1556 15.3014 15.538 16.1522 15.6357C15.0621 17.9084 15.9618 20.6512 18.2109 21.8288C18.3002 21.876 18.3895 21.9181 18.4805 21.9585C17.4915 24.1908 18.3844 26.8358 20.5662 28L27.2411 15.2449Z"
                fill="#4012AB"
              />
            </svg>
            <span>Pagos seguros por Palomma</span>
          </div>

          <div class="flex items-center justify-center gap-5 text-xs text-[#64748b] font-medium">
            <a
              href="https://palomma.com/legal/terminos"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline text-[#475569] hover:text-[#0f172a]"
            >
              Términos y condiciones
            </a>
            <span>•</span>
            <a
              href="https://palomma.com/legal/privacidad"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline text-[#475569] hover:text-[#0f172a]"
            >
              Políticas de privacidad
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
