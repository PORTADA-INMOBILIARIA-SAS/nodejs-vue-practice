---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/navbar.astro"
---

<Layout title="Portal de Pagos y Recaudos | Portada Inmobiliaria">
  <main class="w-full min-h-screen bg-white flex flex-col font-sans">
    <Navbar />

    <div class="w-full bg-[#222222] py-6 shadow-md flex justify-center">
      <div class="w-full px-6 lg:px-16 flex flex-row items-center justify-center gap-x-20 sm:gap-x-32 lg:gap-x-48">
        <a
          href="/pay-antioquia"
          class="transition-transform duration-300 hover:scale-105 focus:outline-none cursor-pointer flex items-center justify-center"
        >
          <img
            src="/img/img29Antioquia.svg"
            alt="Botón de Pago Antioquia"
            style="height: 100px !important; width: auto !important; max-width: none !important;"
            class="object-contain drop-shadow-lg"
          />
        </a>

        <a
          href="/pay-cundinamarca"
          class="transition-transform duration-300 hover:scale-105 focus:outline-none cursor-pointer flex items-center justify-center"
        >
          <img
            src="/img/img28cundinamarca.png"
            alt="Botón de Pago Cundinamarca"
            style="height: 100px !important; width: auto !important; max-width: none !important;"
            class="object-contain drop-shadow-lg"
          />
        </a>
      </div>
    </div>

    <section class="w-full py-12 px-6 sm:px-12 flex flex-col items-center justify-center flex-grow bg-slate-50">
      <div class="max-w-4xl w-full bg-white rounded-2xl shadow-xl p-8 sm:p-12 flex flex-col items-center text-center">
        <span class="text-xs font-bold text-red-600 uppercase tracking-widest mb-2">
          Guía paso a paso
        </span>
        <h1 class="text-2xl sm:text-4xl font-extrabold text-[#0d1b2a] tracking-tight mb-6">
          ¿Cómo pagar tu arriendo en línea?
        </h1>

        <p class="text-sm sm:text-base text-slate-600 mb-8 max-w-2xl">
          Mira nuestro video instructivo para aprender cómo realizar tu pago de
          manera rápida, fácil y segura.
        </p>

        <div
          id="youtube-player-container"
          class="w-full relative overflow-hidden rounded-xl shadow-lg border border-slate-200 bg-black mb-8 group cursor-pointer"
          style="padding-top: 56.25%;"
        >
          <img
            src="https://i.ytimg.com/vi/fc5ru4aO_N0/hqdefault.jpg"
            alt="Video tutorial cómo pagar arriendo"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-black/30 group-hover:bg-black/30 transition-colors flex items-center justify-center">
            <button
              type="button"
              id="btn-play-video"
              aria-label="Reproducir video instructivo"
              class="w-16 h-16 md:w-20 md:h-20 bg-red-600/90 group-hover:bg-red-600 hover:scale-110 active:scale-95 text-white rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(220,38,38,0.6)] transition-all duration-300 cursor-pointer"
            >
              <svg
                class="w-7 h-7 md:w-8 md:h-8 ml-1 fill-current"
                viewBox="0 0 24 24"
              >
                <path d="M8 5v14l11-7z" />
              </svg>
            </button>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 w-full justify-center">
          <a
            href="/pay-antioquia"
            class="px-8 py-3.5 bg-[#0d1b2a] hover:bg-[#1b263b] text-white font-bold text-xs uppercase tracking-widest rounded-lg transition-all shadow-md cursor-pointer"
          >
            Ir a Pagos Antioquia
          </a>
        </div>
      </div>
    </section>
  </main>

  <script>
    const player_container = document.getElementById("youtube-player-container")
    const play_button = document.getElementById("btn-play-video")

    const loadIframe = () => {
      if (!player_container) return
      player_container.innerHTML = `
        <iframe
          class="w-full h-full absolute inset-0 border-0"
          src="https://www.youtube-nocookie.com/embed/fc5ru4aO_N0?autoplay=1&rel=0&modestbranding=1&playsinline=1"
          title="Tutorial de pago en línea Portada Inmobiliaria"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      `
    }

    player_container?.addEventListener("click", loadIframe, { once: true })
    play_button?.addEventListener("click", loadIframe, { once: true })
  </script>
</Layout>
