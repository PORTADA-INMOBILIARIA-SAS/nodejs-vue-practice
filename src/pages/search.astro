---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/navbar.astro"

import {
  getSearchResults,
  PROPERTY_TYPES,
  PLACES,
  BEDROOM_OPTIONS,
  FEATURE_OPTIONS,
  SORT_OPTIONS,
} from "../lib/searchService"

import MapComponent from "../components/MapComponent.astro"
import SearchFilters from "../components/search/SearchFilters.astro"
import PropertyCard from "../components/search/PropertyCard.astro"
import SearchPagination from "../components/search/SearchPagination.astro"
import SearchSplitMap from "../components/search/SearchSplitMap.astro"

import "../styles/searchMap.css"

export const prerender = false

const searchData = await getSearchResults(Astro.url.searchParams)
const {
  mode,
  city,
  propertyType,
  budget,
  code,
  bedrooms,
  feature,
  sort,
  favoriteCodes,
  visible,
  total,
  totalPages,
  currentPage,
  loadFailed,
  allItemsForMap,
  propertiesForMap,
  countLabel,
} = searchData

const firstPage = Math.max(1, currentPage - 2)
const lastPage = Math.min(totalPages, currentPage + 2)
const pageNumbers = Array.from(
  { length: lastPage - firstPage + 1 },
  (_, index) => firstPage + index,
)

const pageLink = (page: number) => {
  const params = new URLSearchParams(Astro.url.searchParams)
  params.set("page", String(page))
  return `/search?${params.toString()}`
}

const isMapView =
  (Astro.url.searchParams.get("view") || "list").toLowerCase() === "map"

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=300, stale-while-revalidate=600",
)
---

<Layout
  title={
    favoriteCodes.length > 0
      ? "Mis favoritos · Portada Inmobiliaria"
      : "Buscar inmuebles en arriendo y venta · Portada Inmobiliaria"
  }
  description="Encuentra apartamentos, casas y oficinas en arriendo y venta en el Valle de Aburrá y el Oriente Antioqueño con Portada Inmobiliaria."
>
  <Navbar active="search" />

  <main
    class="results-page w-full bg-[#fcfbf8] text-[#2a2a33]"
    style="--escala: 0.8"
  >
    <div class="mx-auto w-full max-w-[1424px] px-5 pb-20 pt-10 sm:px-8">
      <!-- Filtros y encabezado -->
      <SearchFilters
        mode={mode}
        city={city}
        propertyType={propertyType}
        budget={budget}
        code={code}
        bedrooms={bedrooms}
        feature={feature}
        sort={sort}
        favoriteCodes={favoriteCodes}
        places={PLACES}
        propertyTypes={PROPERTY_TYPES}
        bedroomOptions={BEDROOM_OPTIONS}
        featureOptions={FEATURE_OPTIONS}
        sortOptions={SORT_OPTIONS}
      />

      <!-- Contenedor del mapa general interactivo (desplegable) -->
      <div id="general-map-container" class="mt-6 hidden">
        <MapComponent properties={propertiesForMap} />
      </div>

      <!-- Contenedor del listado inferior de inmuebles -->
      <div id="results-content-wrapper">
        <div class="mt-10 flex flex-wrap items-center justify-between gap-3">
          {!loadFailed && (
            <div class="flex items-center gap-2">
              <p class="text-[14px] text-[#2a2a33]">
                <span class="font-medium">
                  {total} {countLabel}
                </span>
                {favoriteCodes.length > 0 && (
                  <a
                    href="/search"
                    class="ml-3 text-[13px] text-[#5e5e68] underline"
                  >
                    Ver todos los inmuebles
                  </a>
                )}
              </p>
            </div>
          )}

          <!-- Alternador de vistas (Lista / Mapa) SIN onclick inline -->
          <div class="inline-flex rounded-xl bg-[#eeebe5] p-1 text-[13px]">
            <button
              type="button"
              id="view-list-btn"
              class={`cursor-pointer rounded-lg px-4 py-1.5 outline-none transition-all focus-visible:ring-2 focus-visible:ring-[#f8a29a] ${
                !isMapView
                  ? "bg-white font-medium text-[#2a2a33] shadow-sm"
                  : "text-[#5e5e68] hover:text-[#2a2a33]"
              }`}
            >
              Lista
            </button>
            <button
              type="button"
              id="view-map-btn"
              class={`cursor-pointer rounded-lg px-4 py-1.5 outline-none transition-all focus-visible:ring-2 focus-visible:ring-[#f8a29a] ${
                isMapView
                  ? "bg-white font-medium text-[#2a2a33] shadow-sm"
                  : "text-[#5e5e68] hover:text-[#2a2a33]"
              }`}
            >
              Mapa
            </button>
          </div>
        </div>

        {loadFailed && (
          <div class="mt-6 rounded-[24px] border border-[#f0c4be] bg-[#fff6f5] px-6 py-10 text-center">
            <p class="text-[16px] text-[#b8382c]">
              No pudimos cargar los inmuebles en este momento.
            </p>
            <a
              href={`/search?mode=${mode}`}
              class="mt-4 inline-block text-[14px] text-[#2a2a33] underline"
            >
              Intentar de nuevo
            </a>
          </div>
        )}

        {!loadFailed && visible.length === 0 && (
          <div class="mt-6 rounded-[24px] border border-[#e6e2da] bg-white px-6 py-14 text-center">
            <p class="text-[18px] font-light text-[#2a2a33]">
              {favoriteCodes.length > 0
                ? "No se encontraron inmuebles en tus favoritos o ya no están disponibles."
                : "No encontramos inmuebles con esos filtros."}
            </p>
            <a
              href={`/search?mode=${mode}`}
              class="mt-4 inline-block text-[14px] text-[#2a2a33] underline"
            >
              {favoriteCodes.length > 0
                ? "Explorar todos los inmuebles"
                : "Limpiar filtros"}
            </a>
          </div>
        )}

        {visible.length > 0 && (
          <>
            <!-- Vista 1: Cuadrícula normal -->
            <div
              id="grid-view-container"
              class={isMapView ? "hidden" : "block"}
            >
              <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {visible.map((property, idx) => (
                  <PropertyCard property={property} idx={idx} />
                ))}
              </div>

              <SearchPagination
                currentPage={currentPage}
                totalPages={totalPages}
                pageNumbers={pageNumbers}
                pageLink={pageLink}
              />
            </div>

            <!-- Vista 2: Mapa dividido + columna de propiedades -->
            <SearchSplitMap
              isMapView={isMapView}
              allItemsForMap={allItemsForMap}
              propertiesForMap={propertiesForMap}
              totalPages={totalPages}
              currentPage={currentPage}
              pageNumbers={pageNumbers}
              pageLink={pageLink}
            />
          </>
        )}
      </div>
    </div>
  </main>
</Layout>

<script src="../scripts/searchPage.ts"></script>
