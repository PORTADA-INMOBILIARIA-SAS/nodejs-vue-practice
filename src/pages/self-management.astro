---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/navbar.astro"

const etiqueta = "mb-3 block text-[14px] font-medium text-[#1e1e24]"
const campo =
  "h-[60px] w-full rounded-2xl border border-[#d6d1c7] bg-[#fdfcfb] px-[18px] text-[16px] text-[#1e1e24] outline-none transition-all placeholder:text-[#7a7a84] focus:border-[#1e1e24] focus:bg-white"
const boton =
  "flex h-[60px] w-full cursor-pointer items-center justify-center gap-2 rounded-2xl bg-[#ffaaa0] text-[16px] font-medium text-[#1e1e24] shadow-sm transition-colors hover:bg-[#ff958a]"
---

<Layout title="Autogestión Portada - Portada Inmobiliaria">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
    />
  </Fragment>
  <Navbar active="autogestion" />

  <main
    class="pagina-autogestion min-h-screen w-full bg-[#fcfbf8] pb-24 text-[#1e1e24]"
    style="--escala: 0.8"
  >
    <div class="mx-auto w-full max-w-[1648px] px-6 pb-12 pt-8">
      <nav
        aria-label="Ruta de navegación"
        class="mb-12 flex items-center gap-4 text-[13px] text-[#55555e]"
      >
        <a href="/" class="hover:underline">
          Inicio
        </a>
        <span aria-hidden="true">/</span>
        <span>Presentación Portada</span>
      </nav>

      <div class="mb-[50px]">
        <p class="mb-[25px] text-[11px] font-medium uppercase tracking-[0.25em] text-[#5e5e68]">
          Autogestión Portada
        </p>
        <h1 class="mb-[27px] text-[34px] font-normal leading-[1.1] tracking-[-0.03em] text-[#1e1e24] lg:text-[52px]">
          Tu información empieza contigo.
        </h1>
        <p class="text-[15.5px] font-light text-[#55555e]">
          Ingresa con tu cédula y un código de verificación, o utiliza tu
          contraseña.
        </p>
      </div>

      <div class="mx-auto grid max-w-[1324px] grid-cols-1 items-start gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
        <div class="rounded-[36px] border border-[#e6e2da] bg-white p-8 shadow-[0_4px_24px_rgba(42,42,51,0.04)] sm:p-[44px]">
          <div class="mb-[37px] inline-flex h-[35px] items-center rounded-full bg-[#fdf1c4] px-[14px] text-[11px] font-medium uppercase tracking-[0.02em] text-[#6b5320]">
            Demostración · sin datos reales
          </div>

          <h2 class="mb-6 text-[32px] font-normal leading-[1.15] tracking-[-0.02em] text-[#1e1e24]">
            Ingresa a Mi Portada.
          </h2>
          <p class="mb-[31px] text-[14.5px] font-normal leading-[29px] text-[#5e5e68]">
            Primero verificamos tu identidad. Después podrás consultar tu
            información.
          </p>

          <div class="mb-[35px] flex items-center rounded-[24px] bg-[#f3f0ea] p-[6px] text-[15px]">
            <button
              type="button"
              id="tab-codigo"
              class="h-[57px] flex-1 cursor-pointer rounded-[18px] bg-white text-center font-normal text-[#1e1e24] shadow-sm transition-all"
            >
              Con código
            </button>
            <button
              type="button"
              id="tab-password"
              class="h-[57px] flex-1 cursor-pointer rounded-[18px] text-center font-normal text-[#1e1e24] transition-all"
            >
              Con contraseña
            </button>
          </div>

          <form
            id="form-con-codigo"
            class="flex flex-col"
            onsubmit="event.preventDefault();"
          >
            <div>
              <label for="cedula-input" class={etiqueta}>
                Número de cédula de ejemplo
              </label>
              <input
                type="text"
                id="cedula-input"
                name="cedula"
                autocomplete="off"
                placeholder="Usa una cédula de la demostración"
                class={campo}
              />
            </div>

            <div class="mt-[30px]">
              <label for="destino-select" class={etiqueta}>
                Recibir el código en
              </label>
              <select
                id="destino-select"
                name="destino"
                class={`${campo} cursor-pointer`}
              >
                <option value="email">Correo registrado</option>
                <option value="sms">Celular registrado · SMS</option>
              </select>
            </div>

            <p class="mt-8 text-[12.5px] text-[#6b6b75]">
              El destino corresponde a los datos registrados para esa cédula.
            </p>

            <button type="submit" id="btn-submit-code" class={`${boton} mt-6`}>
              <span>Recibir código</span>
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                />
              </svg>
            </button>

            <p class="mt-4 text-center text-[12.5px] text-[#6b6b75]">
              Solo se aceptan las cuentas de ejemplo de esta presentación.
            </p>
          </form>

          <form
            id="form-con-password"
            class="hidden space-y-6"
            onsubmit="event.preventDefault();"
          >
            <div>
              <label for="cedula-input-pass" class={etiqueta}>
                Número de cédula de ejemplo
              </label>
              <input
                type="text"
                id="cedula-input-pass"
                autocomplete="off"
                placeholder="Usa una cédula de la demostración"
                class={campo}
              />
            </div>

            <div>
              <label for="password-input" class={etiqueta}>
                Contraseña de ejemplo
              </label>
              <div class="flex items-center gap-3">
                <input
                  type="password"
                  id="password-input"
                  autocomplete="current-password"
                  placeholder="Usa la contraseña de ejemplo"
                  class="h-[60px] flex-1 rounded-2xl border border-[#d6d1c7] bg-[#fdfcfb] px-[18px] text-[16px] text-[#1e1e24] outline-none transition-all placeholder:text-[#7a7a84] focus:border-[#1e1e24] focus:bg-white"
                />
                <button
                  type="button"
                  id="btn-toggle-password"
                  class="h-[60px] px-6 rounded-2xl border border-[#d6d1c7] bg-[#fbf9f5] hover:bg-[#f4efe6] text-[14px] font-medium text-[#1e1e24] transition-all cursor-pointer shadow-sm shrink-0"
                >
                  Mostrar
                </button>
              </div>
            </div>

            <div>
              <button
                type="button"
                id="link-volver-codigo"
                class="text-[13.5px] font-normal text-[#1e1e24] hover:underline cursor-pointer"
              >
                Olvidé mi contraseña · ingresar con código
              </button>
            </div>

            <button type="submit" class={boton}>
              <span>Ingresar</span>
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                />
              </svg>
            </button>

            <p class="text-center text-[12.5px] font-normal text-[#757167]">
              Solo se aceptan las cuentas de ejemplo de esta presentación.
            </p>
          </form>

          <div class="mt-[38px] border-t border-[#f0ece5] pt-8">
            <span class="inline-flex items-center gap-1.5 text-[13px] text-[#35566f] cursor-pointer">
              <span>
                ¿Ya no tienes acceso a tu celular o correo? Contacta a Portada
              </span>
              <span aria-hidden="true">→</span>
            </span>
          </div>
        </div>

        <div class="pt-8">
          <div class="flex h-[90px] w-[90px] items-center justify-center rounded-[26px] bg-[#e6eff6] text-[#2f3b45]">
            <svg
              class="h-9 w-9"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="7.5" cy="8.5" r="5.5" />
              <path d="m21 22-9.6-9.6" />
              <path d="m15.5 16.5 3-3L22 17l-3 3" />
            </svg>
          </div>

          <p class="mt-[37px] text-[11px] font-medium uppercase tracking-[0.22em] text-[#5e5e68]">
            Un acceso para cada cliente
          </p>
          <h2 class="mt-[25px] text-[32px] font-normal leading-[1.35] tracking-[-0.02em] text-[#1e1e24] lg:text-[42px]">
            Lo tuyo,
            <br />
            en tu espacio.
          </h2>
          <p class="mt-[22px] max-w-[500px] text-[16px] font-light leading-[32px] text-[#55555e]">
            El propietario consulta sus ingresos. El arrendatario consulta sus
            pagos. Cada cuenta muestra la información asociada a su identidad.
          </p>

          <div class="mt-[33px] rounded-[28px] border border-[#ebe6dc] bg-[#f7f4ec] p-7 sm:p-8">
            <h3 class="mb-[15px] text-[18px] font-medium text-[#1e1e24]">
              Prueba el recorrido
            </h3>
            <p class="mb-6 text-[13px] font-normal text-[#6b6b75]">
              Usa únicamente estos datos ficticios.
            </p>

            <div class="space-y-4">
              <div
                class="cedula-card cursor-pointer rounded-2xl border border-[#e6e2da] bg-white px-5 py-[21px] transition-all hover:border-[#b5b1a9]"
                data-cedula="1000000001"
              >
                <p class="mb-3 text-[13px] text-[#6b6b75]">
                  Arrendatario de ejemplo
                </p>
                <div class="flex items-center justify-between gap-4">
                  <p class="text-[18px] font-medium tracking-wide text-[#1e1e24]">
                    1000000001
                  </p>
                  <button
                    type="button"
                    class="inline-flex items-center gap-1 text-[12px] font-normal text-[#55555e] transition-colors hover:text-[#1e1e24]"
                  >
                    <span>Usar esta cédula</span>
                    <span aria-hidden="true">→</span>
                  </button>
                </div>
              </div>

              <div
                class="cedula-card cursor-pointer rounded-2xl border border-[#e6e2da] bg-white px-5 py-[21px] transition-all hover:border-[#b5b1a9]"
                data-cedula="1000000002"
              >
                <p class="mb-3 text-[13px] text-[#6b6b75]">
                  Propietario de ejemplo
                </p>
                <div class="flex items-center justify-between gap-4">
                  <p class="text-[18px] font-medium tracking-wide text-[#1e1e24]">
                    1000000002
                  </p>
                  <button
                    type="button"
                    class="inline-flex items-center gap-1 text-[12px] font-normal text-[#55555e] transition-colors hover:text-[#1e1e24]"
                  >
                    <span>Usar esta cédula</span>
                    <span aria-hidden="true">→</span>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <p class="mt-8 max-w-[540px] text-[13px] font-light leading-[26px] text-[#6b6b75]">
            Esta pantalla simula el acceso. No envía códigos ni protege datos
            reales; la autenticación y los permisos por cliente requieren
            conexión al sistema de Portada.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  .pagina-autogestion,
  .pagina-autogestion * {
    font-family: "Poppins", sans-serif;
    text-rendering: optimizeLegibility;
  }
  @media (min-width: 1024px) {
    .pagina-autogestion {
      zoom: var(--escala, 1);
    }
  }
</style>

<script>
  function setupAutogestion() {
    const tabCodigo = document.getElementById("tab-codigo")
    const tabPassword = document.getElementById("tab-password")
    const formCodigo = document.getElementById("form-con-codigo")
    const formPassword = document.getElementById("form-con-password")
    const cedulaInput = document.getElementById(
      "cedula-input",
    ) as HTMLInputElement | null
    const cedulaInputPass = document.getElementById(
      "cedula-input-pass",
    ) as HTMLInputElement | null

    if (!tabCodigo || tabCodigo.dataset.listo === "1") return
    tabCodigo.dataset.listo = "1"

    tabCodigo.addEventListener("click", () => {
      tabCodigo.classList.add("bg-white", "shadow-sm")
      tabPassword?.classList.remove("bg-white", "shadow-sm")

      formCodigo?.classList.remove("hidden")
      formPassword?.classList.add("hidden")
    })

    tabPassword?.addEventListener("click", () => {
      tabPassword.classList.add("bg-white", "shadow-sm")
      tabCodigo.classList.remove("bg-white", "shadow-sm")

      formPassword?.classList.remove("hidden")
      formCodigo?.classList.add("hidden")
    })

    // Toggle password
    const btnTogglePassword = document.getElementById("btn-toggle-password")
    const passwordInput = document.getElementById(
      "password-input",
    ) as HTMLInputElement | null

    btnTogglePassword?.addEventListener("click", () => {
      if (!passwordInput) return
      const isPassword = passwordInput.type === "password"
      passwordInput.type = isPassword ? "text" : "password"
      btnTogglePassword.textContent = isPassword ? "Ocultar" : "Mostrar"
    })

    // Switch back to code tab
    const linkVolverCodigo = document.getElementById("link-volver-codigo")
    linkVolverCodigo?.addEventListener("click", () => {
      tabCodigo?.click()
    })

    document.querySelectorAll(".cedula-card").forEach((card) => {
      card.addEventListener("click", () => {
        const cedula = card.getAttribute("data-cedula") || ""
        if (cedulaInput) {
          cedulaInput.value = cedula
          cedulaInput.focus()
          cedulaInput.classList.add("ring-2", "ring-[#ffaaa0]")
          setTimeout(
            () => cedulaInput.classList.remove("ring-2", "ring-[#ffaaa0]"),
            1200,
          )
        }
        if (cedulaInputPass) {
          cedulaInputPass.value = cedula
        }
      })
    })

    formCodigo?.addEventListener("submit", (e) => {
      e.preventDefault()
      const val = cedulaInput?.value.trim()
      if (!val) {
        alert("Por favor ingresa o selecciona una cédula de la demostración.")
        cedulaInput?.focus()
        return
      }
      alert(
        `Demostración: Código de verificación enviado para la cédula ${val}.`,
      )
    })
  }

  setupAutogestion()
  document.addEventListener("astro:page-load", setupAutogestion)
</script>
