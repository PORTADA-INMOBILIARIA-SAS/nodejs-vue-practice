---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/navbar.astro"

const logo_src = "/img/img11.webp"
---

<Layout title="Portal de Autogestión - Portada Inmobiliaria">
  <Navbar />

  <main class="relative w-full min-h-[calc(100vh-89px)] py-16 flex items-center justify-center bg-slate-900">
    <div class="absolute inset-0 z-0">
      <img
        src="/img/img27.webp"
        alt="Fondo Portal de Autogestión"
        class="w-full h-full object-cover object-center brightness-110 contrast-105"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-slate-950/30"></div>
    </div>

    <section class="relative z-10 w-full max-w-[350px] mx-4 bg-[#0a1118]/35 backdrop-blur-xl border border-white/25 rounded-3xl p-7 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.4)] flex flex-col items-center text-white">
      <div class="mb-5 flex justify-center">
        <img
          src={logo_src}
          alt="Portada Inmobiliaria SAS"
          class="h-10 w-auto object-contain drop-shadow-md"
        />
      </div>

      <div class="mb-5 text-center">
        <h1 class="text-lg font-bold tracking-wide uppercase text-white drop-shadow">
          PORTAL DE AUTOGESTIÓN
        </h1>
        <p class="text-sm font-bold text-red-500 tracking-wider uppercase mt-0.5">
          Clientes
        </p>
      </div>

      <form class="w-full space-y-4" onsubmit="return false;">
        <div class="relative w-full">
          <select
            aria-label="Tipo de documento"
            class="w-full bg-[#0a1118]/40 border border-white/30 text-gray-100 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-white/60 transition-colors appearance-none cursor-pointer backdrop-blur-md"
          >
            <option
              value=""
              disabled
              selected
              class="bg-slate-900 text-gray-300"
            >
              - Tipo de documento
            </option>
            <option value="CC" class="bg-slate-900 text-gray-100">
              Cédula de Ciudadanía
            </option>
            <option value="CE" class="bg-slate-900 text-gray-100">
              Cédula de Extranjería
            </option>
            <option value="NIT" class="bg-slate-900 text-gray-100">
              NIT
            </option>
            <option value="PAS" class="bg-slate-900 text-gray-100">
              Pasaporte
            </option>
          </select>
          <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-gray-300">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
              <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"></path>
            </svg>
          </div>
        </div>

        <div class="w-full">
          <input
            type="text"
            placeholder="Número de Documento"
            class="w-full bg-[#0a1118]/40 border border-white/30 text-gray-100 text-sm rounded-xl px-4 py-3 placeholder-gray-300 focus:outline-none focus:border-white/60 transition-colors backdrop-blur-md"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-[#121c2c]/60 hover:bg-[#1a283f]/90 text-white font-bold text-sm tracking-wider uppercase py-3 rounded-xl border border-white/40 hover:border-white/70 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 shadow-xl cursor-pointer mt-3 backdrop-blur-md"
        >
          Continuar
        </button>
      </form>
    </section>
  </main>
</Layout>
