---
import Layout from "../layouts/Layout.astro"
import Navbar from "../components/navbar.astro"

const servicios = [
  {
    titulo: "Arrendamientos",
    descripcion:
      "Arrienda o pon en arriendo tu inmueble con acompañamiento de principio a fin.",
    href: "/search?mode=rent",
    fondo: "bg-[#e5eef6]",
    boton: "",
    icono: "home",
  },
  {
    titulo: "Ventas",
    descripcion: "Compra o vende tu inmueble con asesoría.",
    href: "/search?mode=sale",
    fondo: "bg-[#fff0c9]",
    boton: "",
    icono: "key",
  },
  {
    titulo: "Mantenimientos",
    descripcion: "Cuidamos tu inmueble con reparaciones y mantenimientos.",
    href: "/pqrs",
    fondo: "bg-[#fee4df]",
    boton: "",
    icono: "wrench",
  },
  {
    titulo: "Avalúos",
    descripcion: "Conoce el valor real de tu inmueble.",
    href: "/contact",
    fondo: "bg-[#e5eef6]",
    boton: "",
    icono: "tag",
  },
  {
    titulo: "Anticipos",
    descripcion: "Recibe hasta 10 meses de canon de tu inmueble arrendado.",
    href: "https://crm.mascowork.com/solicitud.php",
    fondo: "bg-[#fff0c9]",
    boton: "!border-transparent !bg-[#e5eef6] !text-[#1f4e79]",
    icono: "cash",
    esModalMascowork: true,
  },
  {
    titulo: "Financiación",
    descripcion: "Financia tu primer canon o tu vivienda con Más Cowork.",
    href: "https://crm.mascowork.com/solicitud.php",
    fondo: "bg-[#e5eef6]",
    boton: "!border-transparent !bg-[#fff0c9] !text-[#7a5c0a]",
    icono: "wallet",
    esModalMascowork: true,
  },
]
---

<Layout
  title="Nosotros y servicios - Portada Inmobiliaria"
  description="Detrás de cada puerta, una historia. Acompañamos a quienes buscan un lugar y a quienes confían su inmueble."
  showFooter={true}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
    />
  </Fragment>
  <Navbar active="servicios" />

  <main
    class="pagina-servicios min-h-screen w-full bg-[#fdfcf9] pb-28 text-[#1e1e24]"
    style="--escala: 0.8"
  >
    <div class="contenido-servicios mx-auto w-full max-w-[1580px] px-6 pt-8 sm:px-10 lg:px-0 lg:pt-6">
      <nav
        aria-label="Ruta de navegación"
        class="mb-10 flex items-center gap-4 text-[14px] text-[#55555e] lg:mb-[47px]"
      >
        <a href="/" class="hover:underline">
          Inicio
        </a>
        <span aria-hidden="true">/</span>
        <span>Presentación Portada</span>
      </nav>

      <section class="mb-14">
        <p class="mb-6 text-[11px] font-medium uppercase tracking-[0.25em] text-[#6b6b75]">
          Somos Portada
        </p>
        <h1 class="text-[34px] sm:text-[42px] lg:text-[50px] font-normal leading-[1.1] tracking-[-0.03em] text-[#1e1e24]">
          Detrás de cada puerta, una historia.
        </h1>
        <p class="mt-[26px] text-[17.5px] text-[#4a4a55]">
          Acompañamos a quienes buscan un lugar y a quienes confían su inmueble.
        </p>

        <div class="mt-[42px] grid grid-cols-1 overflow-hidden rounded-[36px] border border-[#eee9df] bg-[#f4f0e8] lg:grid-cols-[809fr_771fr]">
          <div class="relative min-h-[380px] w-full overflow-hidden sm:min-h-[460px] lg:min-h-[526px]">
            <img
              src="/img/img1.webp"
              alt="Personas, espacios y nuevos comienzos"
              class="h-full w-full object-cover"
              loading="eager"
            />
          </div>

          <div class="flex flex-col justify-center p-8 sm:p-12 lg:p-[52px]">
            <p class="text-[11px] font-medium uppercase tracking-[0.22em] text-[#787884]">
              Profesionales en vivir mejor
            </p>
            <h2 class="mt-[22px] text-[32px] sm:text-[40px] lg:text-[44px] font-normal leading-[1.3] lg:leading-[58px] tracking-[-0.02em] text-[#1e1e24]">
              Personas, espacios
              <br />y nuevos comienzos.
            </h2>
            <p class="mt-6 max-w-[520px] text-[16.5px] leading-[31px] text-[#55555e]">
              Una experiencia cercana para encontrar, habitar y cuidar un
              inmueble.
            </p>
          </div>
        </div>
      </section>

      <section class="mt-20">
        <h2 class="text-[30px] sm:text-[38px] lg:text-[40px] font-normal leading-[1.15] tracking-[-0.02em] text-[#1e1e24]">
          Nuestros servicios
        </h2>

        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
          {servicios.map((s) => (
            <article
              class={`flex min-h-[330px] flex-col rounded-[36px] p-8 transition-all hover:shadow-md lg:min-h-[362px] lg:p-10 ${s.fondo}`}
            >
              <div class="flex h-[65px] w-[65px] items-center justify-center rounded-[18px] bg-white/70 text-[#2a2a33]">
                {s.icono === "home" && (
                  <svg
                    class="h-[30px] w-[30px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m3 12 2-2m0 0 7-7 7 7M5 10v10a1 1 0 0 0 1 1h3m10-11 2 2m-2-2v10a1 1 0 0 1-1 1h-3m-6 0a1 1 0 0 0 1-1v-4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v4a1 1 0 0 0 1 1m-6 0h6"
                    />
                  </svg>
                )}
                {s.icono === "key" && (
                  <svg
                    class="h-[30px] w-[30px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    viewBox="0 0 24 24"
                  >
                    <circle cx="7.5" cy="8.5" r="5.5" />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m21 22-9.6-9.6"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m15.5 16.5 3-3L22 17l-3 3"
                    />
                  </svg>
                )}
                {s.icono === "wrench" && (
                  <svg
                    class="h-[30px] w-[30px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
                    />
                  </svg>
                )}
                {s.icono === "tag" && (
                  <svg
                    class="h-[30px] w-[30px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 6h.008v.008H6V6Z"
                    />
                  </svg>
                )}
                {s.icono === "cash" && (
                  <svg
                    class="h-[30px] w-[30px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    viewBox="0 0 24 24"
                  >
                    <rect
                      width="20"
                      height="14"
                      x="2"
                      y="5"
                      rx="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <circle
                      cx="12"
                      cy="12"
                      r="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M6 12h.01M18 12h.01"
                    />
                  </svg>
                )}
                {s.icono === "wallet" && (
                  <svg
                    class="h-[30px] w-[30px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"
                    />
                  </svg>
                )}
              </div>

              <h3 class="mt-[31px] text-[22px] font-medium leading-[30px] text-[#1e1e24]">
                {s.titulo}
              </h3>

              <p class="text-[15px] font-normal leading-[28px] text-[#55555e]">
                {s.descripcion}
              </p>

              <div class="mt-auto pt-7">
                <a
                  href={s.href}
                  data-mascowork-modal={s.esModalMascowork ? "true" : undefined}
                  target={s.esModalMascowork ? "_blank" : undefined}
                  rel={s.esModalMascowork ? "noopener noreferrer" : undefined}
                  class={`btn-servicio inline-flex h-[60px] w-full items-center justify-center gap-3 rounded-[18px] border border-[#e8e2d8] bg-[#fffdfa] text-[16px] font-medium text-[#1e1e24] transition-all hover:brightness-[0.98] ${s.boton}`}
                >
                  <span>Conocer más</span>
                  <svg
                    class="h-[18px] w-[18px]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M5 12h14m-6-6 6 6-6 6"
                    />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </main>

  <!-- Modal con iframe para solicitud en Más Cowork -->
  <div
    id="modal-mascowork"
    class="fixed inset-0 z-50 hidden flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 sm:p-6"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-mascowork-title"
  >
    <div class="relative flex flex-col w-full max-w-4xl max-h-[92vh] rounded-[28px] border border-[#e8e2d8] bg-white shadow-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-200">
      <!-- Cabecera del modal -->
      <div class="flex items-center justify-between border-b border-[#f0ebe3] px-6 py-4 bg-[#fffdfa]">
        <div class="flex items-center gap-3">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#fff0c9] text-[#7a5c0a]">
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              viewBox="0 0 24 24"
            >
              <rect
                width="20"
                height="14"
                x="2"
                y="5"
                rx="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </div>
          <div>
            <h4
              id="modal-mascowork-title"
              class="text-[16px] font-semibold text-[#1e1e24] leading-snug"
            >
              Solicitud de Financiación y Anticipos
            </h4>
            <p class="text-[12px] text-[#6b6b75]">En alianza con Más Cowork</p>
          </div>
        </div>

        <button
          type="button"
          id="btn-cerrar-modal"
          aria-label="Cerrar ventana"
          class="flex h-10 w-10 items-center justify-center rounded-full bg-[#f4efe8] text-[#5e5e68] transition-colors hover:bg-[#e8e1d5] hover:text-[#1e1e24] cursor-pointer"
        >
          <svg
            class="h-5 w-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </div>

      <!-- Contenedor del iframe -->
      <div class="relative w-full flex-1 min-h-[550px] bg-[#fdfcfb]">
        <iframe
          id="iframe-mascowork"
          src=""
          data-src="https://crm.mascowork.com/solicitud.php"
          title="Formulario de Solicitud Más Cowork"
          class="h-full min-h-[550px] w-full border-0"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </div>
</Layout>

<script>
  function setupMascoworkModal() {
    const modal = document.getElementById("modal-mascowork")
    const btnCerrar = document.getElementById("btn-cerrar-modal")
    const iframe = document.getElementById(
      "iframe-mascowork",
    ) as HTMLIFrameElement | null
    const triggers = document.querySelectorAll('[data-mascowork-modal="true"]')

    if (!modal) return

    function abrirModal(e: Event) {
      e.preventDefault()
      if (!modal) return

      // Carga el iframe solo al abrir para optimizar rendimiento
      if (iframe && iframe.dataset.src && iframe.src !== iframe.dataset.src) {
        iframe.src = iframe.dataset.src
      }

      modal.classList.remove("hidden")
      document.body.style.overflow = "hidden"
    }

    function cerrarModal() {
      if (!modal) return
      modal.classList.add("hidden")
      document.body.style.overflow = ""
    }

    triggers.forEach((btn) => {
      btn.addEventListener("click", abrirModal)
    })

    btnCerrar?.addEventListener("click", cerrarModal)

    // Cerrar al hacer clic en el backdrop oscuro
    modal.addEventListener("click", (e) => {
      if (e.target === modal) {
        cerrarModal()
      }
    })

    // Cerrar con la tecla Escape
    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !modal.classList.contains("hidden")) {
        cerrarModal()
      }
    })
  }

  setupMascoworkModal()
  document.addEventListener("astro:page-load", setupMascoworkModal)
</script>

<style is:global>
  .pagina-servicios,
  .pagina-servicios * {
    font-family: "Poppins", sans-serif;
    text-rendering: optimizeLegibility;
  }
  @media (min-width: 1024px) {
    .pagina-servicios .contenido-servicios {
      zoom: var(--escala, 1);
    }
  }
</style>
